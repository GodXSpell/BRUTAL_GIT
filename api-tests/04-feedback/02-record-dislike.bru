meta {
  name: Record Dislike Signal
  type: http
  seq: 2
}
post {
  url: {{base_url}}/api/v1/recommendations/{{repo_id}}/feedback
}
headers {
  Authorization: Bearer {{jwt_token}}
  Content-Type: application/json
}
body:json {
  {
    "signal": "DISLIKE",
    "sessionId": "{{session_id}}",
    "rankPosition": 2
  }
}
assert {
  res.status: in [200, 204]
}\n