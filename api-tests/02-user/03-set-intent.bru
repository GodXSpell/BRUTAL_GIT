meta {
  name: Set User Intent
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/v1/me/intent
}
headers {
  Authorization: Bearer {{jwt_token}}
  Content-Type: application/json
}
body:json {
  {
    "intent": "CONTRIBUTOR"
  }
}
assert {
  res.status: in [200, 204]
}
docs {
  Valid values: CONTRIBUTOR, LEARNER, BUILDER
  Test all three separately to verify each works.
}